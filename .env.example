# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase Authentication Configuration (Client-side Web SDK v9+)
# Replace these values with your actual Sayyada Datasub Firebase project credentials:
VITE_FIREBASE_API_KEY="PASTE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="sayyada-datasub.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sayyada-datasub"
VITE_FIREBASE_STORAGE_BUCKET="sayyada-datasub.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="PASTE_SENDER_ID"
VITE_FIREBASE_APP_ID="PASTE_APP_ID"
